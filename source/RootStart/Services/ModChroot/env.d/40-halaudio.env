# HALAudio private PulseAudio socket.
#
# HALAUDIO_PULSE_SERVER is defined in config/config.sh so the transient
# root environment and persistent Debian-family environment use the same
# authoritative value.

if [ -f "$CHROOT_DIR/usr/local/lib/halbridge/HALAudio.py" ]; then
  CHROOT_ENV_VARS+=(
    "PULSE_SERVER=${HALAUDIO_PULSE_SERVER:-unix:/tmp/pa-run/pulse/native}"
  )
fi
