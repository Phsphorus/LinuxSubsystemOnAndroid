# Only advertise GPUBridge when its socket is actually present.
if [ -S "$CHROOT_DIR/mnt/gpubridge/.virgl_test" ]; then
  CHROOT_ENV_VARS+=(
    "VTEST_SOCKET_NAME=/mnt/gpubridge/.virgl_test"
    # Virpipe is selected through Mesa's software-loader path, then forwards
    # its commands to the Android GPUBridge socket rather than llvmpipe.
    "LIBGL_ALWAYS_SOFTWARE=1"
    "GALLIUM_DRIVER=virpipe"
    "MESA_GL_VERSION_OVERRIDE=4.1COMPAT"
    "MESA_GLSL_VERSION_OVERRIDE=410"
  )
fi
