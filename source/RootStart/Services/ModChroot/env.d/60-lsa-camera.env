# Android-camera to Linux V4L2 compatibility. Keep any earlier preload entries,
# including the synthetic-IIO event shim, in the same login-session environment.
if [ -f "$CHROOT_DIR/usr/local/lib/lsa/liblsa-camera-v4l2.so" ]; then
  current_preload=""
  for entry in "${CHROOT_ENV_VARS[@]}"; do
    case "$entry" in LD_PRELOAD=*) current_preload="${entry#LD_PRELOAD=}" ;; esac
  done
  if [ -n "$current_preload" ]; then current_preload="$current_preload:/usr/local/lib/lsa/liblsa-camera-v4l2.so"; else current_preload="/usr/local/lib/lsa/liblsa-camera-v4l2.so"; fi
  CHROOT_ENV_VARS+=("LD_PRELOAD=$current_preload")
  CHROOT_ENV_VARS+=("LSA_CAMERA_MJPEG_URL=http://127.0.0.1:8765/camera.mjpg")
fi