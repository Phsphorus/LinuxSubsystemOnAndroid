#
# Tier-D Linux IIO event ioctl compatibility.
#
# The target-native shim is built by the sensor runtime before
# ModChroot constructs the Debian session environment.
#

if [ -f "$CHROOT_DIR/usr/local/lib/lsa/liblsa-iio-eventshim.so" ]; then
  CHROOT_ENV_VARS+=(
    "LD_PRELOAD=/usr/local/lib/lsa/liblsa-iio-eventshim.so"
  )
fi
