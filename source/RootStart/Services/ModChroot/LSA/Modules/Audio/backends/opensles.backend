#!/data/data/com.termux/files/usr/bin/bash

backend_audio_opensles_probe() {
    [ -x "$LSA_FRAMEWORK_BASE/../Modules/Audio/implementation/lifecycle.sh" ] || { printf 'Audio module lifecycle missing'; return 3; }
    printf 'Linux Pulse/ALSA can stream through the Android OpenSL ES bridge'
}
backend_audio_opensles_start() { LSA_AUDIO_BACKEND=opensles "$LSA_FRAMEWORK_BASE/../Modules/Audio/implementation/lifecycle.sh" start; }
backend_audio_opensles_stop() { "$LSA_FRAMEWORK_BASE/../Modules/Audio/implementation/lifecycle.sh" stop; }
backend_audio_opensles_status() { [ -S "$LSA_CHROOT_DIR/tmp/pa-run/pulse/native" ] && printf RUNNING || printf STOPPED; }

lsa_backend_register audio.opensles Audio B 80000 'capability.linux.chroot;capability.audio.opensles' 'capability.audio.linux;capability.audio.alsa-pulse' backend_audio_opensles_probe backend_audio_opensles_start backend_audio_opensles_stop backend_audio_opensles_status ANDROID_GENERIC NO
