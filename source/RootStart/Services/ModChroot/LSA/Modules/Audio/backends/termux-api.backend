#!/data/data/com.termux/files/usr/bin/bash

backend_audio_termux_api_probe() {
    [ -x "$LSA_FRAMEWORK_BASE/../Modules/Audio/implementation/lifecycle.sh" ] || { printf 'Audio module lifecycle missing'; return 3; }
    printf 'Linux Pulse/ALSA has a buffered Termux:API media playback fallback'
}
backend_audio_termux_api_start() { LSA_AUDIO_BACKEND=termux-api "$LSA_FRAMEWORK_BASE/../Modules/Audio/implementation/lifecycle.sh" start; }
backend_audio_termux_api_stop() { "$LSA_FRAMEWORK_BASE/../Modules/Audio/implementation/lifecycle.sh" stop; }
backend_audio_termux_api_status() { [ -S "$LSA_CHROOT_DIR/tmp/pa-run/pulse/native" ] && printf RUNNING || printf STOPPED; }

lsa_backend_register audio.termux-api Audio Z 0 'capability.linux.chroot;capability.audio.termux-api' 'capability.audio.linux;capability.audio.alsa-pulse' backend_audio_termux_api_probe backend_audio_termux_api_start backend_audio_termux_api_stop backend_audio_termux_api_status ANDROID_GENERIC NO
