#!/bin/sh
set -eu

output="${1:-}"
[ -n "$output" ] || { echo "usage: camera-record <output.mjpg|output.mp4>" >&2; exit 2; }
url="${LSA_CAMERA_MJPEG_URL:-http://127.0.0.1:8765/camera.mjpg}"
duration="${LSA_CAMERA_RECORD_SECONDS:-}"
max_dimension="${LSA_CAMERA_RECORD_MAX_DIMENSION:-1920}"

case "$duration" in
  '') ;;
  *[!0-9.]*|.|*..*)
    echo "LSA_CAMERA_RECORD_SECONDS must be a positive number of seconds" >&2
    exit 2
    ;;
esac

case "$max_dimension" in
  ''|*[!0-9]*)
    echo "LSA_CAMERA_RECORD_MAX_DIMENSION must be a positive pixel count" >&2
    exit 2
    ;;
esac

# The source may be a large still or an already-scaled compatibility frame.
# Constrain only the long edge: recording must not enlarge a modest source.
scale_filter="scale='if(gt(iw,ih),min(iw,${max_dimension}),-2)':'if(gt(iw,ih),-2,min(ih,${max_dimension}))'"

record_mp4(){
  curl_error="$(mktemp)" || return 1
  if [ -n "$duration" ]; then
    if curl -fsSN "$url" 2>"$curl_error" | ffmpeg -hide_banner -loglevel warning -use_wallclock_as_timestamps 1 -f mpjpeg -i - -t "$duration" -vf "$scale_filter" -fps_mode vfr -c:v libx264 -movflags +faststart "$output"; then
      result=0
    else
      result=$?
    fi
  elif curl -fsSN "$url" 2>"$curl_error" | ffmpeg -hide_banner -loglevel warning -use_wallclock_as_timestamps 1 -f mpjpeg -i - -vf "$scale_filter" -fps_mode vfr -c:v libx264 -movflags +faststart "$output"; then
    result=0
  else
    result=$?
  fi
  # ffmpeg intentionally closes the stream when a bounded recording is done.
  # curl then reports its ordinary broken-pipe code; retain all other errors.
  sed '/^curl: (23) /d' "$curl_error" >&2 || true
  rm -f "$curl_error"
  return "$result"
}

case "$output" in
  *.mp4)
    if command -v ffmpeg >/dev/null 2>&1; then
      # The Android provider acquires still frames, so arrival cadence varies
      # with camera latency.  Preserve wall-clock frame timestamps and write a
      # variable-frame-rate MP4 instead of incorrectly presenting snapshots as
      # a fixed 25 fps video.
      record_mp4
      exit $?
    fi
    echo "ffmpeg is not installed; record to a .mjpg file or install ffmpeg for MP4 output" >&2
    exit 3
    ;;
  *.mjpg|*.mjpeg) exec curl -fsSN "$url" -o "$output" ;;
  *) echo "camera-record output must end in .mjpg, .mjpeg, or .mp4" >&2; exit 2 ;;
esac
